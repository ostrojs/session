{
    "name": "@ostro/session",
    "version": "2.0.0-alpha.1",
    "description": "Session module for OstroJS",
    "scripts": {
        "build": "npx tsc -p tsconfig.build.json && mkdir -p build/console/stubs && cp -r src/console/stubs/ build/console/stubs/ && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "test": "npx c8 npx jest",
        "clean": "rm -rf build coverage"
    },
    "main": "build/sessionManager.js",
    "types": "build/sessionManager.d.ts",
    "files": [
        "build"
    ],
    "exports": {
        ".": {
            "types": "./build/sessionManager.d.ts",
            "default": "./build/sessionManager.js"
        },
        "./*": {
            "types": "./build/*.d.ts",
            "default": "./build/*.js"
        }
    },
    "dependencies": {
        "@ostro/console": "^2.0.0-alpha.1",
        "@ostro/contracts": "^2.0.0-alpha.1",
        "@ostro/cookie": "^2.0.0-alpha.1",
        "@ostro/support": "^2.0.0-alpha.1",
        "cookie": "^0.7.2",
        "cookie-signature": "^1.2.1",
        "csrf": "^3.1.0",
        "fs-extra": "^11.4.1",
        "lodash": "^4.17.21",
        "lodash.get": "^4.4.2",
        "on-headers": "^1.0.2",
        "proxy-addr": "^2.0.8",
        "uid-safe": "^2.1.5"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "session",
        "nodejs http session",
        "cookie session"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/session.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/session/issues"
    },
    "homepage": "https://github.com/ostrojs/session#readme",
    "devDependencies": {
        "typescript": "^5.8.0",
        "@types/node": "^22.0.0"
    }
}
