{
    "name": "@ostro/session",
    "version": "2.0.0-alpha.6",
    "description": "Session module for OstroJS",
    "scripts": {
        "build": "npm run lint:check && npx tsc -p tsconfig.build.json && mkdir -p build/console/stubs && cp -r src/console/stubs/ build/console/stubs/ && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "test": "npx c8 npx jest",
        "clean": "rm -rf build coverage",
        "lint:check": "tsc --noEmit -p tsconfig.build.json"
    },
    "main": "sessionManager.js",
    "types": "types/sessionManager.d.ts",
    "exports": {
        ".": {
            "types": "./types/sessionManager.d.ts",
            "default": "./sessionManager.js"
        },
        "./*": {
            "types": "./types/*.d.ts",
            "default": "./*.js"
        }
    },
    "dependencies": {
        "@ostro/console": "^2.0.0-alpha.7",
        "@ostro/contracts": "^2.0.0-alpha.6",
        "@ostro/cookie": "^2.0.0-alpha.5",
        "@ostro/support": "^2.0.0-alpha.7",
        "cookie": "^0.7.2",
        "cookie-signature": "^1.2.2",
        "csrf": "^3.1.0",
        "fs-extra": "^11.4.1",
        "lodash": "^4.17.21",
        "on-headers": "^1.1.0",
        "proxy-addr": "^2.0.8",
        "uid-safe": "^2.1.5"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "session",
        "nodejs http session",
        "cookie session"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/session.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/session/issues"
    },
    "homepage": "https://github.com/ostrojs/session#readme",
    "devDependencies": {
        "typescript": "^5.8.0",
        "@types/node": "^22.0.0",
        "@types/jest": "^30.0.0",
        "c8": "^10.1.3",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "@ostro/builder": "^2.0.0-alpha.4"
    },
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}
